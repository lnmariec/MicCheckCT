# Copy this file to .env and fill in the values from Supabase.
# .env is never uploaded to GitHub. This template is.

# Project URL, for example https://abcdefgh.supabase.co
SUPABASE_URL=

# Public key (Supabase may call it "anon" or "publishable"). Used by the website.
SUPABASE_ANON_KEY=

# Secret key (Supabase may call it "service_role" or "secret"). Scripts only, never the website.
SUPABASE_SERVICE_ROLE_KEY=
